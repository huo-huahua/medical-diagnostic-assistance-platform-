# ---------------------------------------------------------------------------
# BC-Dx Platform — local development configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Never commit a real API key.
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# --- security ---------------------------------------------------------------
# MUST be replaced before exposing this service to anyone. Anyone who knows
# this value can mint a valid login token for any account, including the admin's.
#
# Generate one:  openssl rand -hex 32
#
# The value below is intentionally an obvious placeholder. An earlier version
# of this file shipped something like `dev-only-secret-...-2f8a91c4`, which
# looks random enough to pass a glance — so people copied it and never changed
# it. The backend now refuses to start in production while this value is in
# place, and logs a warning otherwise.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite+pysqlite:///./bcdx.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_MB=10

# --- RAG --------------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30
RAG_MIN_TOKEN_COVERAGE=0.12
ENABLE_RAG_LLM=true

# Chunking. The embedding model silently truncates at its own max_seq_length
# (128 tokens for paraphrase-multilingual-MiniLM-L12-v2), so a chunk larger
# than the window has its tail made invisible to retrieval with no error.
# At index build time the chunker is handed the real tokenizer and budgets in
# tokens; these character values are only the fallback used if the model
# cannot be loaded, plus the min/overlap shared by both modes.
RAG_CHUNK_MAX_CHARS=160
RAG_CHUNK_MIN_CHARS=60
RAG_CHUNK_OVERLAP_CHARS=40

# Retrieval: dense vectors + BM25, fused with Reciprocal Rank Fusion.
#
# Dense retrieval alone is weakest exactly where this corpus is strongest:
# "BI-RADS 4A", "Youden", "数据泄漏". An abbreviation or a number carries almost
# no semantic mass for a sentence encoder, so the ranking drifts to whatever prose
# surrounds it. BM25 has the opposite bias, which is why the two are fused.
#
# Measured with `_tools/eval_retrieval.py` over 15 probes, plus 4 that must be
# refused (expected sections derived from the corpus, not typed in):
#
#   dense          hit@1  9/15   in top-5 12/15   spurious refusals 4   ~24 ms
#   hybrid         hit@1 13/15   in top-5 13/15   spurious refusals 0   ~25 ms
#   hybrid+rerank  hit@1 13/15   in top-5 15/15   spurious refusals 0 ~2241 ms
#
# Turning BM25 off restores the old dense-only ranking, and with it the four
# questions that get refused for no good reason: dense ranks a lexically
# unrelated section first, and the refusal gate then correctly declines to answer
# from a passage sharing no content word with the question. It exists so the
# difference can be re-measured, not because it should be off.
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
# Candidates handed to the reranker. Each one is a cross-encoder forward pass, so
# this is the latency lever if you enable reranking.
RAG_RETRIEVE_CANDIDATES=20

# Cross-encoder reranking. OFF by default — a measurement, not an omission: it
# added ~2.2s per query on CPU (about 90x) and improved no top-1 result, only
# top-5 recall. The local path is the one this project advertises as fast and
# free, so making it slower than the model call it is compared against would be a
# visible regression. Turn it on when top-5 recall matters more than latency.
#
# It is best-effort either way: an unreachable model (offline container, empty
# cache) degrades retrieval to the fused ranking instead of failing, and
# /health's rag_retrieval.rerank_unavailable says so. Enabling it downloads
# ~1.1 GB on first run, so pre-download it into the image if you containerise.
#
# On Windows, huggingface_hub may fail to create the snapshot symlinks and leave
# 0-byte files behind ("OSError: ... is not a valid JSON file" — which looks
# nothing like a download problem). Delete snapshots/ under the model's cache dir
# and re-download with HF_HUB_DISABLE_SYMLINKS=1. Because that failure is
# swallowed by the graceful degradation, you would otherwise only notice that
# reranking silently is not happening — which is why /health reports it.
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_MAX_TOKENS=512

# --- LLM --------------------------------------------------------------------
# The default Q&A pipeline is fully local and costs nothing. Everything below
# only affects the two *external* columns of the comparison view.
#
# To see what the comparison looks like without signing up for anything, use
# the offline demo provider — it runs the real request/parse/accounting code
# with the network replaced by an in-process transport:
#
#     LLM_ENABLED=true
#     LLM_PROVIDER=mock
#
# To reach a real service, pick a provider and add a key:
#
#     LLM_ENABLED=true
#     LLM_PROVIDER=deepseek          # deepseek | openai | qwen | moonshot
#                                    # zhipu | ollama | mock | custom
#     LLM_API_KEY=sk-...
#
# `ollama` needs no key at all and keeps the data on your machine:
#
#     LLM_ENABLED=true
#     LLM_PROVIDER=ollama
#     LLM_MODEL=qwen2.5:7b           # must match `ollama list`
#
# One tiny request verifies whatever you configured, and says *which* thing is
# wrong when it fails (missing key / bad URL / bad model name / rate limit...):
#
#     curl -s -X POST http://127.0.0.1:8000/api/v1/llm/test \
#          -H "Authorization: Bearer $TOKEN"
#
# Full guide, including the error taxonomy: docs/LLM_INTEGRATION.md
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=

# LLM_BASE_URL is used ONLY when LLM_PROVIDER=custom. A named provider always
# keeps its own known-good URL, because letting a stale value win would send the
# request to the previous service and fail with a 401 that reads like an
# expired key. Point these at vLLM / LM Studio / LiteLLM / One-API:
LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL overrides the model name for ANY provider (same host and key, so
# `deepseek-reasoner` on the deepseek preset is a normal thing to want). The
# demo provider ignores it. Leave empty to use the preset's default.
LLM_MODEL=deepseek-chat
LLM_CACHE_SIZE=512
LLM_MIN_CHARS_FOR_CALL=150

# How many models one comparison may fan out to. Each extra model adds two paid
# calls, so this is a cost control rather than a technical limit.
LLM_MAX_COMPARE_MODELS=3

# Demo-channel fault injection. Applies ONLY when LLM_PROVIDER=mock, and is
# ignored by every real provider. Set it to any of the values below to make
# every demo call fail that way on purpose -- that is how you can reproduce the
# error taxonomy (and the panel's "why it failed" message) by hand instead of
# taking the documentation's word for it.
#
#   invalid_key | endpoint_not_found | rate_limited | quota | forbidden
#   server_error | bad_request | timeout | connection | garbage | empty
#
# Leave empty for normal use. A misspelt value is logged and ignored.
LLM_MOCK_FAULT=

# Display-only price estimate, CNY per 1K tokens. Used to annotate the
# comparison view; never used to bill. Ignored for providers that carry their
# own prices in the catalogue (only `custom` falls back to these).
LLM_PRICE_PROMPT_PER_1K=0.002
LLM_PRICE_COMPLETION_PER_1K=0.008

# --- Q&A path comparison ----------------------------------------------------
# The comparison endpoint is opt-in per request and rate limited. It only
# reaches an external model when LLM_ENABLED=true *and* a key is configured.
QA_COMPARE_ALLOW_LLM=true
QA_COMPARE_MAX_QUESTION_CHARS=300

# --- rate limits ------------------------------------------------------------
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_LLM=12/minute
